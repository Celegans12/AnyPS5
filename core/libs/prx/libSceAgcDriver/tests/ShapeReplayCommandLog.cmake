if(NOT DEFINED FIXTURE)
    message(FATAL_ERROR "Missing FIXTURE")
endif()
set(runs 3)
set(modes off replay plans targets both)
set(env_off "APS5_NO_SHAPE_REPLAY=1" "APS5_NO_DRAW_PLANS=1")
set(env_replay "APS5_NO_DRAW_PLANS=1")
set(env_plans "APS5_NO_SHAPE_REPLAY=1")
set(env_targets "APS5_NO_PLANNED_TARGETS=1")
set(env_both "APS5_SHAPE_REPLAY_ON=1")
foreach(mode IN LISTS modes)
    set(streams_${mode})
    foreach(run RANGE 1 ${runs})
        execute_process(
                COMMAND "${CMAKE_COMMAND}" -E env --unset=APS5_NO_SHAPE_REPLAY --unset=APS5_NO_DRAW_PLANS --unset=APS5_NO_PLANNED_TARGETS "ANYPS5_NO_SHADER_CACHE=1" "APS5_COMMAND_LOG=1" "APS5_PIPELINED_DRAWS=0" ${env_${mode}} "${FIXTURE}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60
        )
        if(result STREQUAL "77" AND NOT DEFINED ENV{ANYPS5_REQUIRE_VULKAN})
            message(STATUS "shape replay command log: skipped, no usable Vulkan device")
            return()
        endif()
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "the ${mode} run failed: ${result}\n${output}\n${error}")
        endif()
        string(REGEX MATCHALL "command-log: [^\n]*" lines "${output}")
        string(REGEX MATCHALL "(shape replay|draw plans) [a-z]+: [^\n]*" summary "${output}")
        if(lines STREQUAL "")
            message(FATAL_ERROR "the ${mode} run printed no command log:\n${output}\n${error}")
        endif()
        string(REPLACE ";" " | " lines "${lines}")
        string(REPLACE ";" " | " summary "${summary}")
        list(APPEND streams_${mode} "${lines}")
        message(STATUS "${mode} ${run}: ${summary}; ${lines}")
    endforeach()
endforeach()
foreach(mode IN ITEMS replay plans targets both)
    foreach(streams IN LISTS streams_${mode})
        if(NOT streams IN_LIST streams_off)
            message(FATAL_ERROR "a command stream with ${mode} on matches no run with shape replay and draw plans off:\n${mode}: ${streams}\noff runs: ${streams_off}")
        endif()
    endforeach()
endforeach()
message(STATUS "every command stream with shape replay, draw plans or both on matches one with both off")
