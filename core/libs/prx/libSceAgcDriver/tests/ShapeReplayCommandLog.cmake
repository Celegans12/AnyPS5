if(NOT DEFINED FIXTURE)
    message(FATAL_ERROR "Missing FIXTURE")
endif()
set(runs 3)
foreach(mode IN ITEMS off on)
    if(mode STREQUAL "off")
        set(switch "APS5_NO_SHAPE_REPLAY=1")
    else()
        set(switch "APS5_SHAPE_REPLAY_ON=1")
    endif()
    set(streams_${mode})
    foreach(run RANGE 1 ${runs})
        execute_process(
                COMMAND "${CMAKE_COMMAND}" -E env --unset=APS5_NO_SHAPE_REPLAY "ANYPS5_NO_SHADER_CACHE=1" "APS5_COMMAND_LOG=1" "APS5_PIPELINED_DRAWS=0" "${switch}" "${FIXTURE}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60
        )
        if(result STREQUAL "77" AND NOT DEFINED ENV{ANYPS5_REQUIRE_VULKAN})
            message(STATUS "shape replay command log: skipped, no usable Vulkan device")
            return()
        endif()
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "the ${mode} run failed: ${result}\n${output}\n${error}")
        endif()
        string(REGEX MATCHALL "command-log: [^\n]*" lines "${output}")
        string(REGEX MATCH "shape replay [a-z]+: [^\n]*" summary "${output}")
        if(lines STREQUAL "")
            message(FATAL_ERROR "the ${mode} run printed no command log:\n${output}\n${error}")
        endif()
        string(REPLACE ";" " | " lines "${lines}")
        list(APPEND streams_${mode} "${lines}")
        message(STATUS "${mode} ${run}: ${summary}; ${lines}")
    endforeach()
endforeach()
foreach(streams IN LISTS streams_on)
    if(NOT streams IN_LIST streams_off)
        message(FATAL_ERROR "a command stream with shape replay on matches no run with it off:\non: ${streams}\noff runs: ${streams_off}")
    endif()
endforeach()
message(STATUS "every command stream with shape replay on matches one with it off")
