foreach(variable TOOL CAPTURE)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "${variable} is not set")
    endif()
endforeach()

execute_process(COMMAND "${TOOL}" --prepare "${CAPTURE}/invalid.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "0" OR NOT output MATCHES "prepared: [0-9]+ SPIR-V words")
    message(FATAL_ERROR "preparation of the synthetic request failed: ${code}\n${output}${errors}")
endif()

execute_process(COMMAND "${TOOL}" --materialize "${CAPTURE}/inactive.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "0" OR NOT output MATCHES "materialized: [0-9]+ SPIR-V words")
    message(FATAL_ERROR "inactive image replay failed: ${code}\n${output}${errors}")
endif()

execute_process(COMMAND "${TOOL}" --materialize "${CAPTURE}/invalid.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "1" OR NOT output MATCHES "capture failed: runtime image descriptor is invalid")
    message(FATAL_ERROR "active invalid image replay did not fail at capture: ${code}\n${output}${errors}")
endif()

execute_process(COMMAND "${TOOL}" --materialize "${CAPTURE}/invalid.req" "${CAPTURE}/inactive.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "1" OR NOT output MATCHES "capture failed: runtime image descriptor is invalid" OR NOT output MATCHES "materialized: [0-9]+ SPIR-V words")
    message(FATAL_ERROR "replay did not continue after a failed request: ${code}\n${output}${errors}")
endif()

execute_process(COMMAND "${TOOL}" --maintenance8 --materialize "${CAPTURE}/inactive.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "0" OR NOT output MATCHES "materialized: [0-9]+ SPIR-V words")
    message(FATAL_ERROR "prepared replay with maintenance8 failed: ${code}\n${output}${errors}")
endif()

foreach(mode IN ITEMS --prepare --materialize)
    execute_process(COMMAND "${TOOL}" ${mode} "${CAPTURE}/lds.req" RESULT_VARIABLE code OUTPUT_VARIABLE baseline ERROR_VARIABLE errors)
    if(NOT code STREQUAL "0" OR NOT baseline MATCHES "prepared: [0-9]+ SPIR-V words")
        message(FATAL_ERROR "${mode} of the LDS request failed: ${code}\n${baseline}${errors}")
    endif()
    execute_process(COMMAND "${TOOL}" ${mode} --wave-lds-memory-barriers "${CAPTURE}/lds.req" RESULT_VARIABLE code OUTPUT_VARIABLE overridden ERROR_VARIABLE errors)
    if(NOT code STREQUAL "0" OR NOT overridden MATCHES "prepared: [0-9]+ SPIR-V words")
        message(FATAL_ERROR "${mode} --wave-lds-memory-barriers of the LDS request failed: ${code}\n${overridden}${errors}")
    endif()
    if(baseline STREQUAL overridden)
        message(FATAL_ERROR "${mode} ignored --wave-lds-memory-barriers\n${baseline}")
    endif()
endforeach()
# --pipeline-only: a sidecar whose fingerprint differs refuses the request, unless --no-reference, which builds the
# replay's own pipeline and only reports the sidecar's difference.
set(pipeline "${CAPTURE}/pipeline-only")
file(REMOVE_RECURSE "${pipeline}")
file(MAKE_DIRECTORY "${pipeline}/cache" "${pipeline}/nv-check" "${pipeline}/nv-unchecked")
file(COPY_FILE "${CAPTURE}/inactive.req" "${pipeline}/inactive.req")
file(WRITE "${pipeline}/inactive.fp" "fingerprint 0123456789abcdef\nwords 1\n")
unset(ENV{ANYPS5_NO_SHADER_CACHE})
set(ENV{__GL_SHADER_DISK_CACHE_PATH} "${pipeline}/nv-check")
execute_process(COMMAND "${TOOL}" --pipeline-only --native-target --pipeline-cache "${pipeline}/cache" "${pipeline}/inactive.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(output MATCHES "no Vulkan|vkCreateInstance|no suitable|Vulkan device" AND NOT output MATCHES "pipeline fingerprint")
    message(STATUS "pipeline-only replay skipped: no Vulkan device\n${output}${errors}")
    return()
endif()
if(NOT code STREQUAL "1" OR NOT output MATCHES "pipeline-only fingerprint differs from the game's \\(0123456789abcdef")
    message(FATAL_ERROR "pipeline-only replay accepted a sidecar whose fingerprint differs: ${code}\n${output}${errors}")
endif()
set(ENV{__GL_SHADER_DISK_CACHE_PATH} "${pipeline}/nv-unchecked")
execute_process(COMMAND "${TOOL}" --pipeline-only --no-reference --native-target --pipeline-cache "${pipeline}/cache" "${pipeline}/inactive.req" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT code STREQUAL "0" OR NOT output MATCHES "game sidecar \\(not checked, --no-reference\\): fingerprint differs" OR NOT output MATCHES "PIPELINE-RESULT [^\n]* fingerprint=[0-9a-f]+ create_ms=")
    message(FATAL_ERROR "pipeline-only --no-reference did not build past a differing sidecar: ${code}\n${output}${errors}")
endif()
